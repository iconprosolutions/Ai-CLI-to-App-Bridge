# ──────────────────────────────────────────────────────────────
# AI CLI Bridge — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Claude Bridge ─────────────────────────────────────────────
# Your Anthropic API key (get one at https://console.anthropic.com)
# Leave blank if mounting your Claude Code auth directory instead
ANTHROPIC_API_KEY=

# Override the default Claude model (leave blank to use server default)
# Options: claude-sonnet-4-6, claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-5
CLAUDE_MODEL=

# Port for the Claude Bridge (default: 9002)
CLAUDE_PORT=9002

# ── Gemini Bridge ─────────────────────────────────────────────
# Override the default Gemini model (leave blank to use server default)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-3-flash-preview
GEMINI_MODEL=gemini-2.5-flash

# Port for the Gemini Bridge (default: 9003)
GEMINI_PORT=9003

# ── Network ───────────────────────────────────────────────────
# The IP or hostname of the machine running these bridges.
# Use this when configuring Meeting Hub (or any other app) to point
# at the bridges. If the app runs on the SAME machine: 127.0.0.1
# If the app runs on a different machine (e.g. NAS via Tailscale):
# use the Tailscale IP of this machine (find it with: tailscale ip -4)
BRIDGE_HOST=127.0.0.1

# ── Shared ────────────────────────────────────────────────────
# Your agency / business name (used in AI prompts)
AGENCY_NAME=Your Agency

# Team member names shown to the AI as possible action item assignees
# e.g. "Alice or Bob or Client"
TEAM_MEMBERS=Team Member or Client
