# ──────────────────────────────────────────────
# AI CLI Bridge — Environment Variables
# Copy this file to .env and fill in your values.
#
# NO API KEYS NEEDED. Both bridges use CLI OAuth sessions —
# copy ~/.claude and ~/.gemini from your Mac to the host before
# running docker compose. See docker-compose.yml comments.
#
# SECURITY: set BRIDGE_API_KEY below. Without it, anyone who can
# reach ports 9002/9003 can call the bridges, read/write your
# context files, and spend your Claude/Gemini quota.
# ──────────────────────────────────────────────

# ── Security ───────────────────────────────────────────────────
# Shared secret protecting both HTTP bridges. When set, every
# request (except /health) must send:
#   Authorization: Bearer <your-key>
# Generate one with: openssl rand -hex 32
# Leave blank ONLY if the ports are reachable from localhost only.
BRIDGE_API_KEY=

# Optional CORS allowlist (applies to both bridges). Comma-separated list of
# allowed browser origins, e.g. "https://hub.example.com,https://app.example.com".
# Leave blank to allow all origins (previous behavior).
CORS_ORIGINS=

# ── CLI execution limits (both bridges) ───────────────────────────
# Hard timeout for a single CLI invocation, in milliseconds (default 300000 = 5m).
CLI_TIMEOUT_MS=300000
# Max bytes of CLI stdout/stderr buffered per request; output beyond this is
# truncated to protect memory (default 10485760 = 10MB).
MAX_CLI_OUTPUT_BYTES=10485760

# ── Claude Bridge ─────────────────────────────────────────────
# Override the default Claude model (leave blank to use CLI default)
# Options: claude-sonnet-4-6, claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-5
CLAUDE_MODEL=

# Port for the Claude Bridge (default: 9002)
CLAUDE_PORT=9002

# ── Gemini Bridge ─────────────────────────────────────────────
# Override the default Gemini model (leave blank to use CLI default)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-3-flash-preview
GEMINI_MODEL=gemini-2.5-flash

# Port for the Gemini Bridge (default: 9003)
GEMINI_PORT=9003

# ── Network ───────────────────────────────────────────────────
# The IP or hostname of the machine running these bridges.
# Use this when configuring Meeting Hub to point at the bridges.
# Same machine: 127.0.0.1
# Different machine via Tailscale: run "tailscale ip -4" on this machine
BRIDGE_HOST=127.0.0.1

# ── Shared ────────────────────────────────────────────────────
# Your agency / business name (used in AI prompts)
AGENCY_NAME=Your Agency

# Team member names for action item assignees in meeting analysis
# e.g. "Alice or Bob or Client"
TEAM_MEMBERS=Team Member or Client
